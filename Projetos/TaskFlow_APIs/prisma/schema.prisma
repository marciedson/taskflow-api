// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model tarefas {
  id             Int          @id @default(autoincrement())
  texto          String
  coluna         String       @default("afazer") @db.VarChar(10)
  ordem          Int          @default(0)
  projeto_id     Int
  usuario_id     Int
  criado_em      DateTime?    @default(now()) @db.Timestamp(6)
  id_prioridades Int?
  iniciada_em    String?      @db.VarChar
  concluida_em   String?      @db.VarChar
  prioridades    prioridades? @relation(fields: [id_prioridades], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tarefas_prioridades_fk")
  projetos       projetos     @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios       usuarios     @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model prioridades {
  id        Int       @id(map: "prioridade_pk") @default(autoincrement())
  descricao String    @db.VarChar(20)
  tarefas   tarefas[]
}

model projetos {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(100)
  descricao  String?
  usuario_id Int
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  usuarios   usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tarefas    tarefas[]
}

model usuarios {
  id         Int        @id @default(autoincrement())
  nome       String     @db.VarChar(100)
  email      String     @unique @db.VarChar(150)
  senha_hash String     @db.VarChar(255)
  criado_em  DateTime?  @default(now()) @db.Timestamp(6)
  projetos   projetos[]
  tarefas    tarefas[]
}
